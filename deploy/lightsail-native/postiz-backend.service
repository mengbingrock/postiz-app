[Unit]
Description=Postiz backend
After=network-online.target postgresql.service redis-server.service temporal.service
Wants=network-online.target
Requires=postgresql.service redis-server.service temporal.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/postiz/app
Environment=NODE_ENV=production
Environment=PATH=/opt/node-v22.20.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/pnpm start:prod:backend
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
